new file mode 100644
index 0000000..4c96289
--- /dev/null
+++ b/src/Filee.Core/Settings/OfflinePolicy.cs
@@ -0,0 +1,45 @@
+using System.Net;
+
+namespace Filee.Core.Settings;
+
+/// <summary>Compile-time offline distribution policy. Settings cannot enable networking in this build.</summary>
+public static class OfflinePolicy
+{
+#if FILEE_OFFLINE
+    public static bool Enabled => true;
+#else
+    public static bool Enabled => false;
+#endif
+
+    public static string DataFolderName => Enabled ? "FileeOffline" : "Filee";
+
+    public static void Apply(AppSettings settings)
+    {
+        if (!Enabled)
+            return;
+        settings.CheckForUpdates = false;
+        settings.FirstRunCompleted = true;
+        settings.FeedbackPromptShown = true;
+        if (settings.Language == "auto")
+            settings.Language = "ko";
+    }
+
+    /// <summary>No socket-capable handler is retained in an offline distribution.</summary>
+    public static HttpMessageHandler Guard(HttpMessageHandler onlineHandler)
+    {
+        if (!Enabled)
+            return onlineHandler;
+        onlineHandler.Dispose();
+        return new OfflineHandler();
+    }
+
+    private sealed class OfflineHandler : HttpMessageHandler
+    {
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken) =>
+            Task.FromResult(new HttpResponseMessage(HttpStatusCode.ServiceUnavailable)
+            {
+                RequestMessage = request,
+                Content = new StringContent("오프라인 전용 버전입니다. 필요한 엔진은 배포 파일에 포함되어 있습니다."),
+            });
+    }
+}
