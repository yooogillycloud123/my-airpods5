diff --git a/tests/Filee.App.Tests/OfflineBuildTests.cs b/tests/Filee.App.Tests/OfflineBuildTests.cs
new file mode 100644
index 0000000..8e10acc
--- /dev/null
+++ b/tests/Filee.App.Tests/OfflineBuildTests.cs
@@ -0,0 +1,72 @@
+using System.Net;
+using System.Text.Json;
+using Filee.App.Services;
+using Filee.Core.Settings;
+using Microsoft.Extensions.Logging.Abstractions;
+
+namespace Filee.App.Tests;
+
+public sealed class OfflineBuildTests
+{
+    [Fact]
+    public void Compiled_distribution_has_offline_defaults()
+    {
+        Assert.True(OfflinePolicy.Enabled);
+        var settings = new AppSettings();
+        Assert.False(settings.CheckForUpdates);
+        Assert.True(settings.FirstRunCompleted);
+        Assert.Equal("ko", settings.Language);
+        Assert.False(settings.StartWithSystem);
+        Assert.Equal("FileeOffline", OfflinePolicy.DataFolderName);
+    }
+
+    [Fact]
+    public void Loading_settings_cannot_reenable_online_startup()
+    {
+        var folder = Path.Combine(Path.GetTempPath(), "FileeOffline-test-" + Guid.NewGuid());
+        Directory.CreateDirectory(folder);
+        try
+        {
+            File.WriteAllText(Path.Combine(folder, "settings.json"),
+                "{\"schemaVersion\":20,\"checkForUpdates\":true,\"firstRunCompleted\":false,\"language\":\"auto\"}");
+            var store = new UserDataStore(folder);
+            store.Load();
+            Assert.False(store.Settings.CheckForUpdates);
+            Assert.True(store.Settings.FirstRunCompleted);
+            Assert.Equal("ko", store.Settings.Language);
+        }
+        finally { Directory.Delete(folder, recursive: true); }
+    }
+
+    [Fact]
+    public async Task Manual_and_periodic_update_paths_never_invoke_a_network_handler()
+    {
+        var handler = new CountingHandler();
+        var updates = new UpdateService(NullLogger<UpdateService>.Instance, handler);
+        Assert.Null(await updates.CheckAsync(TestContext.Current.CancellationToken));
+        await updates.UpdateAsync();
+        updates.StartPeriodicChecks(() => true, TimeSpan.Zero);
+        Assert.False(updates.IsUpdateAvailable);
+        Assert.Equal(0, handler.Requests);
+    }
+
+    [Fact]
+    public async Task Guard_blocks_even_accidental_direct_HttpClient_calls()
+    {
+        var handler = new CountingHandler();
+        using var http = new HttpClient(OfflinePolicy.Guard(handler));
+        using var reply = await http.GetAsync("https://example.invalid/", TestContext.Current.CancellationToken);
+        Assert.Equal(HttpStatusCode.ServiceUnavailable, reply.StatusCode);
+        Assert.Equal(0, handler.Requests);
+    }
+
+    private sealed class CountingHandler : HttpMessageHandler
+    {
+        public int Requests { get; private set; }
+        protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken cancellationToken)
+        {
+            Requests++;
+            throw new InvalidOperationException("Offline build reached the online handler.");
+        }
+    }
+}
